    "version": "0.2.0",
    "configurations": [

        {
            "name": "Déboguer C/C++",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/test.c", // Remplace par le chemin de ton exécutable
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb", // Chemin de gdb (par défaut sous Linux)
            "setupCommands": [
                {
                    "description": "Activer le formatage d'impression pour gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
